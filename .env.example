# Copy to .env and fill in your keys (never commit .env).

OPENAI_API_KEY=your_openai_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: LangSmith tracing
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_api_key_here
# LANGCHAIN_PROJECT=deep-research-agent

# Neon / Postgres (SQLAlchemy). Prefer the pooled URL for app traffic.
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Saved browser sessions for authenticated tests. The database stores encrypted
# cookies and localStorage, not the password. Generate a key with:
#   .\.venv\Scripts\python.exe insight\agent\src\auth\capture.py generate-key
# AUTH_DATABASE_URL defaults to DATABASE_URL when unset. Remote hosts need
# sslmode=require (Neon) or verify-full. The key stays in this file, not in the DB.
# AUTH_DATABASE_URL=postgresql://insight_auth:password@db-host:5432/insight_auth?sslmode=require
# AUTH_DATA_KEY=
# AUTH_SESSION_TTL_MINUTES=60

# Neon Object Storage for this branch (from `neon link` / `neon deploy` / `neon env pull`).
# Names look like AWS because Neon is S3-compatible; the endpoint is Neon, not Amazon S3.
# Missing values skip screenshot/video upload without failing the QA run.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL_S3=
# AWS_REGION=us-east-2

# Playwright MCP (required for browser steps). Default is local; on hosted / sidecar
# deployments point at the reachable MCP HTTP URL. INSIGHT_MEDIA_DIR must match the
# MCP process --output-dir (default: .playwright-mcp). Absolute path recommended.
# PLAYWRIGHT_MCP_URL=http://localhost:8931/mcp
# INSIGHT_MEDIA_DIR=.playwright-mcp
# INSIGHT_AUTH_SCRATCH_DIR=.playwright-mcp/auth
